{
  "name": "coursekit-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "courses/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "check:demo": "node packages/tooling/src/cli.ts check courses/demo-mini/src/course.ts",
    "check:fusee": "node packages/tooling/src/cli.ts check courses/fusee/src/course.ts",
    "test": "node packages/tooling/test/run.ts && npm run check:demo && npm run check:fusee && npm run tune:fusee",
    "tune:fusee": "node packages/tooling/src/cli.ts tune courses/fusee/src/tune.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "@types/node": "^22.10.0"
  }
}
